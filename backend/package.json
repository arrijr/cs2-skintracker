{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "echo 'No build step required for Node.js'",
    "postinstall": "npx prisma generate",
    "migrate": "npx prisma migrate deploy",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:reset": "npx prisma migrate reset --force",
    "db:push": "npx prisma db push",
    "db:seed": "node scripts/seed.js",
    "fetch-prices": "node scripts/fetch-prices.js",
    "render:deploy": "node scripts/render-deploy.js",
    "render:start": "node scripts/render-start.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --forceExit --testPathPatterns=src/__tests__",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --forceExit --testPathPatterns=\"(auth|stripe|rate-limiting|tier-gating)\\.test\\.js\"",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --forceExit --testPathPatterns=\"integration\\.test\\.js\"",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --forceExit --testPathPatterns=\"e2e\\.test\\.js\"",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --forceExit --coverage --testPathPatterns=src/__tests__",
    "test:sprint2": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --forceExit --testPathPattern=sprint2",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --watch",
    "test:api-contract": "node ../scripts/test-api-contract.js",
    "test:contract": "node tests/api-contract.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clerk/backend": "^1.15.0",
    "@clerk/express": "^1.7.29",
    "@prisma/client": "^6.12.0",
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "prisma": "^6.12.0",
    "stripe": "^22.1.0",
    "winston": "^3.17.0",
    "winston-transport": "^4.6.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  }
}
