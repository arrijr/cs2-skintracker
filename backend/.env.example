# CS2 Skin Tracker — Backend Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# All vars marked [REQUIRED] must be set in Vercel dashboard before deploy.

# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED] Supabase PostgreSQL connection string (Transaction mode pooler recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres"

# ── Authentication (Clerk) ─────────────────────────────────────────────────────
# [REQUIRED] Clerk secret key — from Clerk dashboard > API Keys
# Production: starts with sk_live_
# Test/dev:   starts with sk_test_
CLERK_SECRET_KEY=sk_live_...

# ── Stripe ────────────────────────────────────────────────────────────────────
# [REQUIRED] Stripe publishable key (safe for frontend too)
STRIPE_PUBLIC_KEY=pk_live_...

# [REQUIRED] Stripe secret key — production starts with sk_live_
# NEVER use sk_test_ in production Vercel env vars
STRIPE_SECRET_KEY=sk_live_...

# [REQUIRED] Stripe webhook signing secret — from Stripe dashboard > Webhooks
# Register: https://<your-vercel-url>/api/v1/webhooks/stripe
# Events:   checkout.session.completed, customer.subscription.*, invoice.payment_*
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from Stripe dashboard > Products)
STRIPE_PRICE_PRO_ID=price_...
STRIPE_PRICE_ENTERPRISE_ID=price_...

# ── CORS ──────────────────────────────────────────────────────────────────────
# [REQUIRED] Comma-separated list of allowed frontend origins
# e.g. https://yourapp.vercel.app,https://www.yourapp.com
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Optional single origin (overridden by ALLOWED_ORIGINS if both set)
# FRONTEND_ORIGIN=https://your-frontend-domain.com

# ── Node ──────────────────────────────────────────────────────────────────────
# [REQUIRED] Must be "production" in Vercel — enables security guards
NODE_ENV=production

# ── Optional / Internal ───────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
ENABLE_EMAILS=false
STEAM_API_KEY=your-steam-api-key

# ── Steam Inventory Import (OpenID) ───────────────────────────────────────────
STEAM_OPENID_RETURN_BASE_URL=http://localhost:5000
STEAM_OPENID_STATE_SECRET=replace-me-with-a-random-32-char-string

# Price update tuning (GitHub Actions cron)
PRICE_UPDATE_BATCH_SIZE=1000
PRICE_UPDATE_ONLY_ACTIVE=true
PRICE_UPDATE_RETRIES=2
PRICE_UPDATE_RETRY_DELAY_MS=200
PRICE_UPDATE_GLOBAL_DELAY_MS=40
PRICE_UPDATE_TAKE=2000
PRICE_UPDATE_SKIP=0

# ── DO NOT SET IN PRODUCTION ──────────────────────────────────────────────────
# These bypass authentication and must NEVER be set in Vercel env vars.
# Dev-only (local .env only):
# DEV_TEST_TOKEN=dev-test-token-sprint1
# DEV_TEST_CLERK_ID=test-clerk-pro-user-001
# DEV_FREE_TOKEN=dev-free-token-sprint1
# DEV_FREE_CLERK_ID=test-clerk-free-user-001
