# Database Configuration
# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/cs2skindb?schema=public"

# Authentication
# Generate a secure random string for JWT signing
JWT_SECRET="your-super-secure-jwt-secret-key-here"

# Email Service Configuration (for price alerts)
# Gmail SMTP configuration (use app-specific password)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"
EMAIL_FROM="CS2 Price Tracker <noreply@cs2tracker.com>"

# Steam API Configuration (optional)
# Get your key from: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY="your-steam-web-api-key"

# Background Agent Configuration
# Whether to run the cron scheduler (set to false in staging/testing)
RUN_SCHEDULER=true

# Price Update Settings
UPDATE_ALL_SKINS=true                    # Update all skins or only active ones
PRICE_UPDATE_BATCH_SIZE=1000             # Number of skins to process per batch
PRICE_UPDATE_GLOBAL_DELAY_MS=40          # Delay between API calls (ms)
PRICE_UPDATE_RETRIES=2                   # Number of retry attempts for failed API calls
PRICE_UPDATE_RETRY_DELAY_MS=200          # Delay between retries (ms)
PRICE_UPDATE_ONLY_ACTIVE=false           # Only update skins with offer volume > 0

# Testing/Development Settings (optional)
# PRICE_UPDATE_TAKE=100                  # Limit number of skins to update (for testing)
# PRICE_UPDATE_SKIP=0                    # Skip first N skins (for testing)

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Settings
CORS_ORIGIN="http://localhost:3000"      # Frontend URL for CORS