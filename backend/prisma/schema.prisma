// backend/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String?    // Optional for Clerk users
  clerkId      String?    @unique // Clerk user ID
  displayName  String?    // Optional display name
  timezone     String?    // IANA timezone string
  emailAlerts  Boolean    @default(true)  // Email notification preference
  pushAlerts   Boolean    @default(false) // Push notification preference
  steamId           String?   @unique
  steamConnectedAt  DateTime?
  tier                    String?   // free | lite | pro (mirrors isPremium for billing)
  stripeCustomerId        String?   @unique
  stripeSubscriptionId    String?   @unique
  subscriptionStatus      String?   // active | canceled | past_due | trialing | null
  billingCycle            String?   // monthly | annual | null (free tier)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean   @default(false)
  isPremium    Boolean    @default(false)
  role         String     @default("user") // user, admin
  preferredCurrency String  @default("EUR")  // EUR | USD | GBP
  themePreference   String  @default("DARK") // DARK | LIGHT | SYSTEM
  onboardingCompletedAt DateTime? // First-sign-in onboarding flow completion timestamp (null = still pending)
  createdAt    DateTime   @default(now())
  watchlist    Watchlist[]
  portfolio    Portfolio[]
  casePortfolio CasePortfolio[]
  portfolioHistory PortfolioHistory[]
  transactions Transaction[]
  auditLogs    AuditLog[]
  jobRuns      JobRun[]
  blogPosts    BlogPost[]
  alerts       Alert[]
}

model Skin {
  id           Int      @id @default(autoincrement())
  name         String   @unique   // ADR-001 (2026-05-11): every skin has a globally-unique display name
  marketHashName String @unique
  imageUrl     String?
  weaponType   String?
  collection   String?
  wear         String?
  rarity       String?
  quality      String?
  isStattrak   Boolean?    // aus isstattrack (1 = true, 0 = false)
  isStar       Boolean?    // aus isstar
  itemType     String?     // aus itemtype
  itemName     String?     // aus itemname
  itemGroup    String?     // aus itemgroup (rifle, pistol, etc.)
  variantOf    Int?        // Loose self-reference: points at base Skin.id for wear/ST variant rows

  // SEO canonical slug — backfilled from marketHashName via slugify() in
  // backend/src/utils/slugify.js. Nullable until backfill completes;
  // the API resolves null → 404 (Sprint 2).
  slug         String?  @unique
  weaponSlug   String?  // pillar-page grouping, e.g. "ak-47", "awp", "karambit"

  // Current prices
  priceLatest  Float?      // aus pricelatest
  priceLatestSell Float?   // aus pricelatestsell
  priceMedian  Float?      // aus pricemedian
  priceAvg     Float?      // aus priceavg
  priceSafe    Float?      // aus pricesafe (95% vom Median)
  priceMin     Float?      // aus pricemin (90-Tage Min)
  priceMax     Float?      // aus pricemax (90-Tage Max)
  
  // Historical prices (90 days)
  priceMedian24h Float?    // aus pricemedian24h
  priceMedian7d  Float?    // aus pricemedian7d
  priceMedian30d Float?    // aus pricemedian30d
  priceMedian90d Float?    // aus pricemedian90d
  priceAvg24h    Float?    // aus priceavg24h
  priceAvg7d     Float?    // aus priceavg7d
  priceAvg30d    Float?    // aus priceavg30d
  priceAvg90d    Float?    // aus priceavg90d
  
  // Sales statistics
  soldToday     Int?       // aus soldtoday
  sold24h       Int?       // aus sold24h
  sold7d        Int?       // aus sold7d
  sold30d       Int?       // aus sold30d
  sold90d       Int?       // aus sold90d
  soldTotal     Int?       // aus soldtotal
  hoursToSold   Float?     // aus hourstosold
  
  // Steam market data
  buyOrderPrice Float?     // aus buyorderprice
  buyOrderMedian Float?    // aus buyordermedian
  buyOrderAvg   Float?     // aus buyorderavg
  buyOrderVolume Int?      // aus buyordervolume
  offerVolume   Int?       // aus offervolume
  
  // Market metadata
  priceUpdatedAt DateTime? // aus priceupdatedat
  unstable       Boolean?  // aus unstable (1 = true, 0 = false)
  unstableReason String?   // aus unstablereason
  
  // Legacy fields (for backward compatibility)
  priceHistory   PriceHistory[]
  watchlist      Watchlist[]
  portfolio      Portfolio[]
  transactions   Transaction[]
  marketSnapshots MarketSnapshot[]
  caseSkins      CaseSkin[]
  quantityHistory SkinQuantityHistory[]
  alerts         Alert[]

  @@index([rarity])
  @@index([wear])
  @@index([priceAvg])
  @@index([variantOf])
  @@index([weaponSlug])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  action    String   // view, create, update, delete
  resource  String   // admin, portfolio, watchlist, etc.
  details   String?  // Additional context
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}


model Watchlist {
  id         Int     @id @default(autoincrement())
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  skin       Skin    @relation(fields: [skinId], references: [id])
  skinId     Int
  priceAlert Float?
  createdAt   DateTime @default(now())

  @@unique([userId, skinId]) // doppelte Einträge verhindern
}

model Alert {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skinId          Int?      // null = portfolio-wide alert
  skin            Skin?     @relation(fields: [skinId], references: [id], onDelete: Cascade)
  caseId          Int?      // for case_ev alerts
  case            Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type            String    // "price_threshold" | "volatility" | "float_tier" | "case_ev"
  config          Json      // type-specific config
  channels        String[]  // ["email", "in_app"]
  isActive        Boolean   @default(true)
  cooldownMinutes Int       @default(60)
  lastTriggeredAt DateTime?
  // Edge-trigger dedup: engine only fires on false→true transition.
  // null = never evaluated; treated as false (so the first match still fires).
  lastConditionState Boolean?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  events          AlertEvent[]

  @@index([userId, isActive])
  @@index([type, isActive])
}

model AlertEvent {
  id          Int       @id @default(autoincrement())
  alertId     Int
  alert       Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  triggeredAt DateTime  @default(now())
  readAt      DateTime? // null = unread; set by /notifications/mark-all-read or /:id/read
  payload     Json
  delivered   String[]
  failed      String[]
  errorLog    String?

  @@index([alertId, triggeredAt])
  @@index([alertId, readAt])
}

model Portfolio {
  id       Int      @id @default(autoincrement())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  skin     Skin     @relation(fields: [skinId], references: [id])
  skinId   Int
  amount   Int
  buyPrice Float
  buyDate  DateTime
  importedFromSteamAt DateTime?
  removedFromSteamAt  DateTime?

  @@index([userId, importedFromSteamAt])
}

model CasePortfolio {
  id       Int      @id @default(autoincrement())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  case     Case     @relation(fields: [caseId], references: [id])
  caseId   Int
  amount   Int
  buyPrice Float
  buyDate  DateTime
  
  @@unique([userId, caseId])
  @@index([userId])
  @@index([caseId])
}

model PriceHistory {
  id      Int      @id @default(autoincrement())
  skinId  Int
  date    DateTime
  price   Float
  source  String?  // null = real recorded point (daily cron / Steam refresh); 'skinport_est' = seeded rolling-window-median estimate (approximate, labelled in UI)
  skin    Skin     @relation(fields: [skinId], references: [id])

  @@unique([skinId, date])
  @@index([skinId, date])
}

model PortfolioHistory {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  date        DateTime
  value       Float
  invested    Float?   @default(0)
  unrealizedPL Float?  @default(0)
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  
  @@index([userId, date])
  @@index([date])
}

model Transaction {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  skin      Skin      @relation(fields: [skinId], references: [id])
  skinId    Int
  type      TransactionType
  amount    Int
  price     Float
  date      DateTime  @default(now())
  notes     String?
  
  @@index([userId, skinId, date])
}

enum TransactionType {
  BUY
  SELL
}

model JobRun {
  id          String   @id @default(cuid())
  jobName     String   // e.g., "updateSkinPrices", "rebuildSnapshots", "steam_skin_import"
  status      String   // "queued", "running", "completed", "failed"
  parameters  Json?    // job parameters as JSON
  dryRun      Boolean  @default(false)
  estimatedImpact String? // e.g., "~50 price writes"
  actualCount Int?     // actual records processed
  insertedCount Int?   // records inserted
  updatedCount Int?    // records updated
  failedCount Int?     // records that failed
  finalCount Int?      // final count after job completion
  details     String?  // detailed status message
  startedAt   DateTime @default(now())
  completedAt DateTime?
  error       String?  // error message if failed
  adminId     Int?     // who triggered the job (optional for system jobs)
  admin       User?    @relation(fields: [adminId], references: [id])
  
  // Rate limiting
  rateLimitKey String?  // for rate limiting (jobName + adminId)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobName, status])
  @@index([adminId])
  @@index([rateLimitKey])
}

model MarketSnapshot {
  id             Int       @id @default(autoincrement())
  itemType       String    @default("skin") // 'skin' | 'case' | 'market_item'
  skinId         Int?
  skin           Skin?     @relation(fields: [skinId], references: [id], onDelete: Cascade)
  caseId         Int?
  case           Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  marketItemId   Int?
  marketItem     MarketItem? @relation(fields: [marketItemId], references: [id], onDelete: Cascade)
  date           DateTime
  priceUsd       Float
  activeListings Int?
  soldVolume24h  Int?
  source         String
  fetchedAt      DateTime  @default(now())

  @@index([itemType, date])
  @@index([skinId, date])
  @@index([marketItemId, date])
}

model MarketItem {
  id              Int       @id @default(autoincrement())
  category        String    // 'sticker' | 'agent' | 'patch' | 'graffiti' | 'music_kit' | 'collectible' | 'key'
  externalId      String    // bymykel id
  name            String
  marketHashName  String    @unique
  imageUrl        String?
  rarity          String?
  collection      String?
  metadata        Json?
  priceLatest     Float?
  priceMedian     Float?
  volume24h       Int?
  priceUpdatedAt  DateTime?
  isActive        Boolean   @default(true)
  consecutive404  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  snapshots       MarketSnapshot[]

  @@index([category, isActive])
  @@index([marketHashName])
}

model Case {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  imageUrl        String?
  description     String?
  releaseDate     DateTime?
  discontinuedDate DateTime?
  isDiscontinued  Boolean  @default(false)
  
  // Current market data
  price           Float?   // Current price in USD
  marketCap       Float?   // Market capitalization
  remaining       Int?     // Remaining supply
  dropped         Int?     // Total dropped
  unboxed         Int?     // Total unboxed
  timeToExtinction Float?  // Estimated months to extinction
  
  // Price changes
  priceChange24h  Float?   // 24h price change %
  priceChange7d   Float?   // 7d price change %
  priceChange30d  Float?   // 30d price change %
  
  // Metadata
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  caseSupply      CaseSupply[]
  caseSkins       CaseSkin[]
  casePriceHistory CasePriceHistory[]
  casePortfolio   CasePortfolio[]
  alerts          Alert[]
  marketSnapshots MarketSnapshot[]

  @@index([isDiscontinued])
  @@index([price])
  @@index([timeToExtinction])
  @@index([lastUpdated])
}

model CaseSupply {
  id          Int      @id @default(autoincrement())
  case        Case     @relation(fields: [caseId], references: [id])
  caseId      Int
  date        DateTime @db.Date // YYYY-MM-DD format
  remaining   Int      // Remaining supply
  dropped     Int      // Total dropped
  unboxed     Int      // Total unboxed
  offerVolume Int?     // Current offer volume from SteamWebAPI
  price       Float?   // Price on this date
  marketCap   Float?   // Market cap on this date
  soldData    String?  // JSON string with sales data (sold24h, sold7d, etc.)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([caseId, date]) // One supply record per case per day
  @@index([caseId, date])
  @@index([date])
}

model CaseSkin {
  id          Int      @id @default(autoincrement())
  case        Case     @relation(fields: [caseId], references: [id])
  caseId      Int
  skin        Skin     @relation(fields: [skinId], references: [id])
  skinId      Int
  rarity      String   // Consumer, Industrial, Mil-Spec, Restricted, Classified, Covert, Exceedingly Rare
  dropChance  Float?   // Drop chance percentage
  isSpecial   Boolean  @default(false) // For special items like knives
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([caseId, skinId]) // One case-skin relationship
  @@index([caseId])
  @@index([skinId])
  @@index([rarity])
}

model CasePriceHistory {
  id          Int      @id @default(autoincrement())
  case        Case     @relation(fields: [caseId], references: [id])
  caseId      Int
  date        DateTime @db.Date // YYYY-MM-DD format
  price       Float    // Price on this date
  marketCap   Float?   // Market cap on this date
  remaining   Int?     // Remaining supply on this date
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([caseId, date]) // One price record per case per day
  @@index([caseId, date])
  @@index([date])
}

model SkinQuantityHistory {
  id              Int      @id @default(autoincrement())
  skin            Skin     @relation(fields: [skinId], references: [id])
  skinId          Int
  date            DateTime @db.Date // YYYY-MM-DD format
  quantity        Int      // Offer volume (active listings) on this date
  activeListings  Int      // Same as quantity, for clarity
  soldVolume24h   Int?     // Number sold in the last 24h from this date
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([skinId, date]) // One quantity record per skin per day
  @@index([skinId, date])
  @@index([date])
}

model BlogPost {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  title         String
  description   String?
  content       String    @db.Text // MDX content
  excerpt       String?
  category      String    // Market Analysis, Investment Guides, Updates, Case Statistics
  tags          String[]  // Array of tags
  authorId      Int
  author        User      @relation(fields: [authorId], references: [id])
  featuredImage String?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  viewCount     Int       @default(0)
  
  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@index([publishedAt])
}